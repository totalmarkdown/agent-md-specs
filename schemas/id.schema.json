{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://totalmarkdown.ai/schemas/id.schema.json",
  "title": "ID.md Schema",
  "description": "Schema for permanent agent identifier",
  "allOf": [
    {
      "$ref": "frontmatter.schema.json"
    }
  ],
  "properties": {
    "required_sections": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "Identity"
      ]
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuing_authority": {
      "type": "string"
    }
  }
}