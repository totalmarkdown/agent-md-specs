{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://totalmarkdown.ai/schemas/whoami.schema.json",
  "title": "WHOAMI.md Schema",
  "description": "Schema for AI agent verifiable identity document",
  "allOf": [
    {
      "$ref": "frontmatter.schema.json"
    }
  ],
  "properties": {
    "required_sections": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "Identity",
        "Verification"
      ]
    },
    "agent_name": {
      "type": "string"
    },
    "agent_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "owner": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  }
}