{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://totalmarkdown.ai/schemas/escalation.schema.json",
  "title": "ESCALATION.md Schema",
  "description": "Schema for human-in-the-loop escalation procedures",
  "allOf": [
    {
      "$ref": "frontmatter.schema.json"
    }
  ],
  "properties": {
    "required_sections": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "Levels",
        "Triggers",
        "Contacts"
      ]
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "level",
          "trigger",
          "action",
          "contact"
        ],
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 1
          },
          "trigger": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "contact": {
            "type": "string"
          }
        }
      }
    }
  }
}