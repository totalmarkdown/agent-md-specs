{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://totalmarkdown.ai/schemas/frontmatter.schema.json",
  "title": "agent-md-specs Frontmatter",
  "description": "Required YAML frontmatter fields for all agent-md-specs files",
  "type": "object",
  "required": [
    "spec_name",
    "spec_version",
    "category",
    "tier"
  ],
  "properties": {
    "spec_name": {
      "type": "string",
      "description": "Name of the spec (e.g., DELEGATION.md)"
    },
    "spec_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version (e.g., 0.1.0)"
    },
    "category": {
      "type": "string",
      "enum": [
        "Business",
        "Cognitive",
        "Cognitive/Growth",
        "Communication",
        "Community",
        "Competitive/Identity",
        "Competitive/Strategic",
        "Compliance",
        "Coordination",
        "Discovery/Marketing",
        "Economic",
        "Example",
        "Governance",
        "Identity",
        "Legal",
        "Lifecycle",
        "Lore",
        "Marketing/Discovery",
        "Marketing/Identity",
        "Operational",
        "Operations",
        "Organizational",
        "Organizational Identity",
        "Performance/Governance",
        "Personality",
        "Planning",
        "Process",
        "Process/Governance",
        "Quality",
        "Quality/Trust",
        "Regulatory Compliance",
        "Safety",
        "Safety/Governance",
        "Security",
        "Social",
        "Strategic/Marketing",
        "Strategic/Operations",
        "Technical",
        "Technical/Documentation",
        "Technical/Interface",
        "Transparency",
        "Transparency/Trust"
      ]
    },
    "tier": {
      "type": "string",
      "enum": [
        "core",
        "extended"
      ]
    },
    "spec_type": {
      "type": "string",
      "enum": [
        "static",
        "runtime_schema"
      ],
      "description": "Whether this spec defines static configuration or runtime data schemas"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Very High",
        "High",
        "Medium",
        "Low"
      ]
    },
    "volume": {
      "type": "string",
      "pattern": "^Vol \\d+"
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z0-9]+md\\.dev$",
      "description": "Reserved .dev domain (e.g., delegationmd.dev)"
    }
  },
  "if": {
    "properties": {
      "tier": {
        "const": "core"
      }
    }
  },
  "then": {
    "required": [
      "spec_name",
      "spec_version",
      "category",
      "tier",
      "priority",
      "domain"
    ]
  }
}